# 複製成 .env 後填。已存在的環境變數優先於這個檔案。
APP_ENV=development
HTTP_ADDR=:7802

# Supabase，本機開發也連同一台，不需要 local Postgres。連線字串在
# Dashboard → Project Settings → Database → Connection string → Session pooler。
# 這台上還有別的 side project，資料全部放在 referral_code_bonus schema 底下。
DATABASE_URL=postgres://postgres.<project-ref>:<密碼>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# goose 的版本表要放哪。留空的話 goose 放 public.goose_db_version。
# 連的是跟別人共用的資料庫（例如 Supabase）時一定要設，不要弄髒 public。
# GOOSE_TABLE=referral_code_bonus.goose_db_version

# 忘記密碼的驗證碼與寄送次數放這裡。連不上會直接啟動失敗——這是登入流程的一部分，
# 不是可有可無的快取。REDIS_TLS 給託管的 redis（Upstash、ElastiCache）用，本機那台是 false。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# 寄信。SMTP_HOST 留空時信不會真的寄出去，改成印進 log（驗證碼直接看得到），
# 本機開發不用先架 SMTP；APP_ENV=production 而這欄留空會在啟動時就擋下來。
# 本機想看排版的話跑一台 Mailpit：SMTP_HOST=127.0.0.1 SMTP_PORT=1025，帳密留空。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=推薦碼交流站

# 忘記密碼的三道限制：碼多久過期、同一組碼能猜錯幾次、每小時能索取幾組新碼。
PASSWORD_RESET_TTL=10m
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_MAX_SENDS=5

# 至少 32 個字元，正式環境務必換掉：openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-before-production-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# app / admin / web 三個前端的開發 port。5175 是 app 的備位——5174 被佔住時 vite 會往上跳一號。
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# 社群登入。Apple 在 app 端是 bundle id、web 端是 Services ID，兩個都要列。
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# 自動下架門檻：最近 10 筆回報中失效達 3 筆且佔比 60% 以上就下架。
AUTO_DISABLE_MIN_REPORTS=3
AUTO_DISABLE_FAIL_RATIO=0.6

# RevenueCat。訂閱的真相在 RevenueCat，後端只收 webhook 存一份副本供伺服器端判斷。
# WEBHOOK_AUTH 是 RevenueCat 後台 Integrations → Webhooks 那個 Authorization header
# 欄位填的值，原樣比對；留空的話那支路由直接回 404，不會無驗證收單。
REVENUECAT_WEBHOOK_AUTH=
PRO_ENTITLEMENT=pro
# 免費方案同時上架的張數上限，Pro 不限。
FREE_ACTIVE_CODE_LIMIT=3

# 後台上傳服務商 logo / 分類圖用。留空的話上傳端點會直接回錯誤，其他功能不受影響。
# Dashboard → Settings → API Keys。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
