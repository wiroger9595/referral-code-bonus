# 複製成 .env 後填。已存在的環境變數優先於這個檔案。
APP_ENV=development
HTTP_ADDR=:7802

# Supabase，本機開發也連同一台，不需要 local Postgres。連線字串在
# Dashboard → Project Settings → Database → Connection string → Session pooler。
# 這台上還有別的 side project，資料全部放在 referral_code_bonus schema 底下。
DATABASE_URL=postgres://postgres.<project-ref>:<密碼>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# goose 的版本表要放哪。留空的話 goose 放 public.goose_db_version。
# 連的是跟別人共用的資料庫（例如 Supabase）時一定要設，不要弄髒 public。
# GOOSE_TABLE=referral_code_bonus.goose_db_version

# 忘記密碼的驗證碼與寄送次數放這裡。連不上會直接啟動失敗——這是登入流程的一部分，
# 不是可有可無的快取。REDIS_TLS 給託管的 redis（Upstash、ElastiCache）用，本機那台是 false。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# 寄信。SMTP_HOST 與 RESEND_API_KEY 都留空時信不會真的寄出去，改成印進 log
# （驗證碼直接看得到），本機開發不用先架 SMTP；APP_ENV=production 而兩者都留空
# 會在啟動時就擋下來。本機想看排版的話跑一台 Mailpit：SMTP_HOST=127.0.0.1 SMTP_PORT=1025，帳密留空。
#
# 正式環境用 Resend 的話走它的 SMTP relay 就好，不用另外設 RESEND_API_KEY：
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=<Resend API key，re_ 開頭>
# MAIL_FROM 要是在 Resend 那邊驗證過網域的地址，沒驗證過會被拒收。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=推薦碼交流站

# 走 Resend 的 HTTP API 而不是上面的 SMTP relay 才需要設這個，設了會優先於 SMTP
# （見 internal/mailer）。兩條路只需要選一條，不用兩個都填。
RESEND_API_KEY=

# 忘記密碼的三道限制：碼多久過期、同一組碼能猜錯幾次、每小時能索取幾組新碼。
PASSWORD_RESET_TTL=10m
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_MAX_SENDS=5

# 至少 32 個字元，正式環境務必換掉：openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-before-production-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# app / admin / web 三個前端的開發 port。5175 是 app 的備位——5174 被佔住時 vite 會往上跳一號。
# 要在實機測 refcode-app 時另外加：capacitor://localhost（iOS WebView 的 origin）、
# https://localhost（Android，capacitor.config.ts 設了 androidScheme: 'https'）。
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# 社群登入。Apple 在 app 端是 bundle id、web 端是 Services ID，兩個都要列。
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# 自動下架門檻：最近 10 筆回報中失效達 3 筆且佔比 60% 以上就下架。
AUTO_DISABLE_MIN_REPORTS=3
AUTO_DISABLE_FAIL_RATIO=0.6

# RevenueCat。訂閱的真相在 RevenueCat，後端只收 webhook 存一份副本供伺服器端判斷。
# WEBHOOK_AUTH 是 RevenueCat 後台 Integrations → Webhooks 那個 Authorization header
# 欄位填的值，原樣比對；留空的話那支路由直接回 404，不會無驗證收單。
REVENUECAT_WEBHOOK_AUTH=rc_webhook_live_9f8a7b6c5d4e3f2g1
PRO_ENTITLEMENT=refcode_pro

# 免費方案同時上架的張數上限，Pro 不限。
FREE_ACTIVE_CODE_LIMIT=3

# ── 排序引擎 ────────────────────────────────────────────────────────────
# 服務商頁的推薦碼順序。每次請求重新加權抽樣，權重是四項相乘：
#   品質分數 × 新鮮度加成 × 曝光懲罰 × Pro 常駐加成
# 全部留空就是用 internal/ranking 的預設值，這裡只是讓正式環境不重新 build 就能調。
#
# 新碼的加成上限。0.5 代表最多 +50%。
RANK_FRESHNESS_BOOST=0.5
#
# 「黃金期」：碼上架後這段時數內維持滿額加成，之後才開始衰減。
# DECAY 是時間常數——每過這麼久，剩下的加成掉到約 37%。
# 免費和 Pro 走兩條曲線，這是訂閱的主要賣點：免費的碼半天內就退回基準線，
# Pro 的能在前排待三天。注意起算點是「審核通過」而不是「送出」，
# 所以審核佇列塞車會直接延後黃金期（待審佇列已讓 Pro 優先，就是為了這件事）。
RANK_FREE_GRACE_HOURS=6
RANK_FREE_DECAY_HOURS=3
RANK_PRO_GRACE_HOURS=72
RANK_PRO_DECAY_HOURS=168
#
# 曝光懲罰的軟上限：累積這麼多次曝光時權重約打對折。
# 這是整套排序最重要的一項——沒有它，前幾名會被同一批碼長期佔住，
# 新上架的人看不到成效就不會再回來，供給端會枯竭。必須大於 0，否則啟動時直接擋下。
RANK_IMPRESSION_SOFT_CAP=100
#
# Pro 上架者的常駐加成，跟碼的新舊無關。預設 0：付費買到的是黃金期長度，
# 不是永久的排序特權——碼一旦過了新鮮期就該純粹由品質和曝光決定位置。
# 想讓 Pro 的老碼也有優勢再往上調，但調高等於讓列表長期被付費者的舊碼佔住。
RANK_PRO_BOOST=0

# 後台上傳服務商 logo / 分類圖用。留空的話上傳端點會直接回錯誤，其他功能不受影響。
# Dashboard → Settings → API Keys。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
