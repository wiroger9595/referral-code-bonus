NUXT_PUBLIC_API_BASE=http://localhost:7802
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Google 登入的 OAuth client id（Web application 那種）。留空就不顯示 Google 按鈕，
# 只留 email + 密碼。這裡填的 id 同時要列進 refcode-api 的 GOOGLE_CLIENT_IDS，
# 後端拿它比對 ID token 的 aud，兩邊沒對上會登入失敗。
# Google Cloud Console 的 Authorized JavaScript origins 也要加上本站網址
# （本機是 http://localhost:3000），沒加按鈕不會出現。
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# 刪除帳號頁的求助信箱。沒填就不顯示那一行，送審前一定要填。
NUXT_PUBLIC_SUPPORT_EMAIL=robertsmart1989@gmail.com
