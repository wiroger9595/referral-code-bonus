VITE_API_BASE_URL=http://localhost:7802

# 帳號頁的聯絡方式與條款連結。沒設定就不顯示那幾列 ——
# 但 UGC app 送審一定要有（Apple 1.2），上架版本兩個都要填。
VITE_SUPPORT_EMAIL=
VITE_SITE_URL=

# 社群登入。留空的 provider 不會出現在登入頁。
# 這裡填的 client id 同時要列進 refcode-api 的 GOOGLE_CLIENT_IDS / APPLE_CLIENT_IDS，
# 後端拿它比對 ID token 的 aud，兩邊沒對上會登入失敗。
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=

# Apple 只有 web 與 Android 要填（iOS 走系統原生流程，用 bundle id，不需要 Services ID）。
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URL=

# RevenueCat。兩把都是 public SDK key，可以進前端（Dashboard → API keys）。
# 沒填的平台整組購買功能會停用，Pro 狀態改看後端 /v1/me 的 is_pro。
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
# 要跟 refcode-api 的 PRO_ENTITLEMENT 一致，兩邊指的是 RevenueCat 上同一個 entitlement。
VITE_REVENUECAT_ENTITLEMENT=pro
